# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chatapp"
# DATABASE_REPLICA_1_URL="postgresql://postgres:password@replica1:5432/chatapp"
# DATABASE_REPLICA_2_URL="postgresql://postgres:password@replica2:5432/chatapp"

# Redis
REDIS_URL="redis://localhost:6379"

# App URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CLIENT_URL="http://localhost:3000"
API_URL="http://localhost:3001"

# WebSocket Configuration
NEXT_PUBLIC_SOCKET_URL="ws://localhost:4000"
REACT_APP_WS_URL="ws://localhost:4000"
WS_PORT=4000
SOCKET_SERVER_PORT=4000

# Authentication
# For JWT-based auth
JWT_SECRET="your-secret-key-change-in-production"
# For Clerk-based auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_publishable_key"
CLERK_SECRET_KEY="sk_test_your_secret_key"

# Server
PORT=3001
NODE_ENV="development"

# Railway Deployment
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="chatapp"

# Optional: AWS Configuration (if using file uploads)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key 