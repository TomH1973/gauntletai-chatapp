// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextIndex"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MessageStatus {
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum FileType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  ARCHIVE
  OTHER
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  image         String?
  isActive      Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastSeen      DateTime?
  messages      Message[]
  threads       ThreadParticipant[]
  reactions     MessageReaction[]
  uploads       Attachment[]
  edits         MessageEdit[]

  @@index([email])
  @@index([lastSeen])
  @@index([isActive])
}

model Thread {
  id            String    @id @default(cuid())
  name          String
  title         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime?
  messages      Message[]
  participants  ThreadParticipant[]
  settings      ThreadSettings?

  @@index([lastMessageAt])
  @@index([updatedAt])
}

model ThreadSettings {
  id              String   @id @default(cuid())
  threadId        String   @unique
  thread          Thread   @relation(fields: [threadId], references: [id])
  isPrivate       Boolean  @default(false)
  allowReactions  Boolean  @default(true)
  allowReplies    Boolean  @default(true)
  allowAttachments Boolean @default(true)
  updatedBy       String
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([threadId])
}

model ThreadParticipant {
  id        String   @id @default(cuid())
  userId    String
  threadId  String
  joinedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  thread    Thread   @relation(fields: [threadId], references: [id])

  @@unique([userId, threadId])
  @@index([userId])
  @@index([threadId])
}

model Message {
  id          String       @id @default(cuid())
  content     String
  userId      String
  threadId    String
  parentId    String?
  status      MessageStatus @default(SENT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id])
  thread      Thread       @relation(fields: [threadId], references: [id])
  parent      Message?     @relation("MessageReplies", fields: [parentId], references: [id])
  replies     Message[]    @relation("MessageReplies")
  reactions   MessageReaction[]
  attachments Attachment[]
  edits       MessageEdit[]
  messageReactions Reaction[]

  @@index([threadId])
  @@index([userId])
  @@index([parentId])
  @@index([status])
  @@index([createdAt])
}

model MessageReaction {
  id        String   @id @default(cuid())
  emoji     String
  userId    String
  messageId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  message   Message  @relation(fields: [messageId], references: [id])

  @@unique([userId, messageId, emoji])
  @@index([messageId])
  @@index([userId])
}

// For full-text search
model MessageSearch {
  id          String   @id
  content     String
  messageId   String
  threadId    String
  userId      String
  createdAt   DateTime

  @@index([content], map: "message_search_content_idx")
  @@index([threadId])
  @@index([userId])
  @@index([createdAt])
  @@index([threadId, createdAt])
  @@index([userId, createdAt])
}

model MessageEdit {
  id        String   @id @default(cuid())
  messageId String
  editedBy  String
  content   String
  createdAt DateTime @default(now())

  // Relations
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  editor    User     @relation(fields: [editedBy], references: [id])

  @@index([messageId])
  @@index([editedBy])
  @@index([createdAt])
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  emoji     String
  users     String[]
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, emoji])
  @@index([messageId])
}

model Attachment {
  id        String   @id @default(cuid())
  filename  String
  key       String   @unique
  url       String
  size      Int
  mimeType  String
  fileType  String
  isPublic  Boolean  @default(false)
  isDeleted Boolean  @default(false)
  messageId String?
  uploaderId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  message   Message? @relation(fields: [messageId], references: [id])
  uploader  User    @relation(fields: [uploaderId], references: [id])

  @@index([messageId])
  @@index([uploaderId])
  @@index([fileType])
  @@index([isPublic])
  @@index([isDeleted])
} 