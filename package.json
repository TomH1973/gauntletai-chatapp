{
  "name": "chatapp",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.3.4",
    "date-fns": "^2.29.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "socket.io-client": "^4.6.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "cross-env PORT=3000 react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "server": "cd server && npm start",
    "dev": "concurrently \"npm run server\" \"npm start\"",
    "wsl:server": "cd server && bash ./start-wsl.sh",
    "wsl:client": "bash ./start-client-wsl.sh",
    "wsl:dev": "concurrently \"npm run wsl:server\" \"npm run wsl:client\"",
    "wsl:db:migrate": "cd server && npx prisma migrate dev",
    "wsl:db:generate": "cd server && npx prisma generate",
    "wsl:docker:up": "wsl docker-compose -f docker-compose.wsl.yml up",
    "wsl:docker:down": "wsl docker-compose -f docker-compose.wsl.yml down",
    "wsl:docker:build": "wsl docker-compose -f docker-compose.wsl.yml build",
    "wsl:docker:db": "wsl docker-compose -f docker-compose.wsl.yml up postgres"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/socket.io-client": "^1.4.36",
    "autoprefixer": "^10.4.13",
    "concurrently": "^8.0.1",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.21",
    "tailwindcss": "^3.2.7",
    "typescript": "^4.9.5"
  }
}
