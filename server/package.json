{
  "name": "chatapp-server",
  "version": "1.0.0",
  "description": "Chat application server with AI integration",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon --config nodemon.json index.js",
    "hot": "NODE_ENV=development nodemon --config nodemon.json --legacy-watch index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "wsl:start": "bash ./start-wsl.sh",
    "wsl:dev": "NODE_ENV=development nodemon --config nodemon.json --legacy-watch index.js",
    "wsl:migrate": "npx prisma migrate dev",
    "wsl:generate": "npx prisma generate",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^2.0.22",
    "prisma": "^5.10.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "setupFilesAfterEnv": ["<rootDir>/tests/setup.js"]
  }
} 